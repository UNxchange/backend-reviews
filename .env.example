# Variables de entorno para el Microservicio de Reviews en Java
# Copia este archivo a .env y ajusta los valores según tu configuración

# Configuración de MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=unxchange_reviews

# Configuración JWT (debe coincidir con el backend de autenticación)
SECRET_KEY=your-super-secret-key-change-this-in-production-unxchange-2025
ALGORITHM=HS256

# Configuración de CORS
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:8080
